<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/seller/:sellerId/products" method="GET">
        <service class="MyCompany\SellerModule\Api\SellerManagementInterface" method="getProducts"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/seller/:sellerId/products" method="POST">
        <service class="MyCompany\SellerModule\Api\SellerManagementInterface" method="saveProduct"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/seller/:sellerId/products/:entityId" method="DELETE">
        <service class="MyCompany\SellerModule\Api\SellerManagementInterface" method="deleteProduct"/>
        <resources><resource ref="self"/></resources>
    </route>

    <route url="/V1/seller/:sellerId/orders" method="GET">
        <service class="MyCompany\SellerModule\Api\SellerManagementInterface" method="getOrders"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/seller/:sellerId/orders" method="POST">
        <service class="MyCompany\SellerModule\Api\SellerManagementInterface" method="saveOrder"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/seller/:sellerId/orders/:entityId" method="DELETE">
        <service class="MyCompany\SellerModule\Api\SellerManagementInterface" method="deleteOrder"/>
        <resources><resource ref="self"/></resources>
    </route>

    <route url="/V1/seller/:sellerId/payments" method="GET">
        <service class="MyCompany\SellerModule\Api\SellerManagementInterface" method="getPayments"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/seller/:sellerId/payments" method="POST">
        <service class="MyCompany\SellerModule\Api\SellerManagementInterface" method="savePayment"/>
        <resources><resource ref="self"/></resources>
    </route>
    <route url="/V1/seller/:sellerId/payments/:entityId" method="DELETE">
        <service class="MyCompany\SellerModule\Api\SellerManagementInterface" method="deletePayment"/>
        <resources><resource ref="self"/></resources>
    </route>
</routes>
